# ---- Servidor ----
PORT=3000
# Escute só localmente e coloque Nginx/Caddy na frente (HTTPS).
HOST=127.0.0.1
# Quantos proxies confiar para obter o IP real (loopback = proxy na mesma máquina).
TRUST_PROXY=loopback
# Opcional: cabeçalho com o IP real do visitante. Use "cf-connecting-ip" se o domínio
# estiver com o proxy da Cloudflare (nuvem laranja) ligado. Deixe vazio caso contrário.
CLIENT_IP_HEADER=

# ---- Cloudflare Turnstile ----
# Crie em https://dash.cloudflare.com/?to=/:account/turnstile (domínio: leandroboari.com)
# Chaves abaixo são as de TESTE da Cloudflare (sempre passam). Troque em produção.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Opcional: aceite tokens só destes hostnames (separados por vírgula)
TURNSTILE_HOSTNAMES=

# ---- SMTP ----
# Deixe SMTP_HOST vazio para modo dev (mensagens só no log).
SMTP_HOST=
SMTP_PORT=587
# true para porta 465 (TLS implícito); false para 587 (STARTTLS obrigatório)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente (precisa ser autorizado pelo seu provedor SMTP) e destino
MAIL_FROM="Site leandroboari.com <nao-responda@leandroboari.com>"
MAIL_TO=contato@leandroboari.com
